import pandas as pd
import joblib
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import StandardScaler
import os

print("🔄 Loading your trained data...")

# Load YOUR features + labels
features = pd.read_csv("output_files/fis_fi_tsfresh_features.csv", index_col=0)
labels = pd.read_csv("input_files/fis_diagnostic.csv")

# Match IDs
common_ids = set(features.index) & set(labels['ID'])
features = features.loc[list(common_ids)]
labels = labels[labels['ID'].isin(common_ids)]['UPDRS'].values

print(f"✅ {len(features)} videos ready")

# Train + Save BEST MODEL
scaler = StandardScaler()
X_scaled = scaler.fit_transform(features.fillna(0))

model = RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1)
model.fit(X_scaled, labels)

# CREATE FOLDERS + SAVE
os.makedirs("result_files", exist_ok=True)
joblib.dump(model, "result_files/best_model.pkl")
joblib.dump(scaler, "result_files/best_scaler.pkl")

print("🚀 BEST MODEL SAVED!")
print(f"✅ Training Accuracy: {model.score(X_scaled, labels):.1%}")
print("✅ Ready for live patients!")